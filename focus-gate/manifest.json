{
  "manifest_version": 3,
  "name": "Focus Gate",
  "version": "1.0",
  "description": "Block your own tempting sites with a toggle you control.",
  "permissions": ["storage", "declarativeNetRequest", "alarms", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["block.html", "block.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Gate"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
